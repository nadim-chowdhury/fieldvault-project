# ╔═══════════════════════════════════════════════════════╗
# ║  FieldVault API — Environment Variables               ║
# ║  Copy this file to .env and update the values         ║
# ╚═══════════════════════════════════════════════════════╝

# ─── Server ──────────────────────────────────────────────
NODE_ENV=development                         # development | production | test
PORT=3001
APP_URL=http://localhost:3001

# ─── Database (required) ────────────────────────────────
DATABASE_URL=postgresql://fieldvault:fieldvault_dev_password@localhost:5432/fieldvault

# ─── Redis (required) ───────────────────────────────────
REDIS_URL=redis://:fieldvault_redis_password@localhost:6379

# ─── JWT (required — minimum 32 characters each) ────────
JWT_ACCESS_SECRET=your_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Cloudinary (optional in development) ────────────────
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── SendGrid (optional in development) ─────────────────
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# EMAIL_FROM=alerts@fieldvault.io
