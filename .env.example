# ╔═══════════════════════════════════════════════════════╗
# ║  FieldVault — Root Environment Variables              ║
# ║  Used by docker-compose for PostgreSQL & Redis        ║
# ║  Copy this file to .env and update the values         ║
# ╚═══════════════════════════════════════════════════════╝

# ─── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=fieldvault
POSTGRES_PASSWORD=fieldvault_dev_password
POSTGRES_DB=fieldvault

# ─── Redis ───────────────────────────────────────────────
REDIS_PASSWORD=fieldvault_redis_password

# ─── Connection Strings (consumed by apps/api) ──────────
DATABASE_URL=postgresql://fieldvault:fieldvault_dev_password@localhost:5432/fieldvault
REDIS_URL=redis://:fieldvault_redis_password@localhost:6379
